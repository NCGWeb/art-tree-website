# Copy this file to .env.local for local development
# (In Vercel: Project Settings -> Environment Variables, add the same names/values there.)

# Password for the /admin login screen. CHANGE THIS before you go live.
ADMIN_PASSWORD=changeme123

# Random long string used to sign the admin session cookie (HMAC via `jose`).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Vercel Blob read/write token, used to persist admin content edits and uploaded images.
# Get this from the Vercel dashboard -> your project -> Storage -> create/open a Blob store
# -> copy the "BLOB_READ_WRITE_TOKEN". Locally you can also run `vercel env pull .env.local`
# once the project is linked with `vercel link`.
BLOB_READ_WRITE_TOKEN=
